--cpu Cortex-M3
"01-led1\startup_stm32f103xb.o"
"01-led1\main.o"
"01-led1\gpio.o"
"01-led1\stm32f1xx_it.o"
"01-led1\stm32f1xx_hal_msp.o"
"01-led1\stm32f1xx_hal_gpio_ex.o"
"01-led1\stm32f1xx_hal.o"
"01-led1\stm32f1xx_hal_rcc.o"
"01-led1\stm32f1xx_hal_rcc_ex.o"
"01-led1\stm32f1xx_hal_gpio.o"
"01-led1\stm32f1xx_hal_dma.o"
"01-led1\stm32f1xx_hal_cortex.o"
"01-led1\stm32f1xx_hal_pwr.o"
"01-led1\stm32f1xx_hal_flash.o"
"01-led1\stm32f1xx_hal_flash_ex.o"
"01-led1\stm32f1xx_hal_exti.o"
"01-led1\system_stm32f1xx.o"
--library_type=microlib --strict --scatter "01-LED1\01-LED1.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
